# =====================================================
# HR Properties Frontend — Environment Variables
# =====================================================
# Copy this file to .env and fill in real values.
# All variables marked "required" MUST be set before docker compose up.

# === Required — Build-time (baked into the JS bundle) ===
# URL pública del backend API (vía Cloudflare Tunnel del backend)
# Ejemplo: https://api.hr-properties.tu-dominio.com/api/
VITE_API_BASE_LOCAL=https://api.hr-properties.tu-dominio.com/api/

# Google OAuth client ID (mismo que el backend)
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# === Required — Cloudflare Tunnel ===
# Get this from: Cloudflare Zero Trust → Networks → Tunnels → Create tunnel
TUNNEL_TOKEN=eyJ-your-tunnel-token-here